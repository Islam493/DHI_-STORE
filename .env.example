# انسخ هاد الملف لـ .env.local وعمّر القيم (فـ Vercel: Settings > Environment Variables)

NEXT_PUBLIC_SITE_URL=https://dhielectronics.store
# رقم الواتساب بصيغة دولية بلا + (مثال 0555123456 => 213555123456)
NEXT_PUBLIC_WHATSAPP=
# رقم الهاتف كما يبان للزبون
NEXT_PUBLIC_PHONE=

# Supabase (Project Settings > API) — باش تتحفظ الطلبيات
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# تيليغرام — إشعار فوري كي تجي طلبية
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pixels
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=

# كلمة السر تاع لوحة التحكم (/admin) — دير وحدة قوية
ADMIN_PASSWORD=

# شركة التوصيل World Express (EcoTrack) — المفتاح من حسابك عندهم
ECOTRACK_URL=https://worldexpress.ecotrack.dz
ECOTRACK_TOKEN=
